# ---------- Куратор: поиск и отбор тем ----------
# anthropic (Claude с веб-поиском, по умолчанию) | ollama (только ранжирует RSS, без поиска)
CURATOR_PROVIDER=anthropic
CURATOR_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Искать свежие материалы в интернете помимо RSS-лент
CURATOR_WEB_SEARCH=true
# Насколько свежие материалы брать (дней) и сколько тем отбирать за один запуск
CURATOR_DAYS=7
CURATOR_PICKS=5
FEEDS_FILE=feeds.txt
QUEUE_FILE=queue.json

# ---------- Автор: сценарий, описание, теги ----------
# ollama (локально, по умолчанию) | anthropic (облако)
WRITER_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# По-русски: qwen2.5:14b (нужно ~10 ГБ видеопамяти) заметно чище, чем qwen2.5:7b.
# Ещё варианты: gemma3:12b, qwen2.5:32b (для мощных карт). Скачать: ollama pull qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b
# Только если WRITER_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5
# Редакторский проход после черновика: грамматика, живость, укладка в хронометраж
WRITER_POLISH=true

# ---------- Озвучка ----------
# По естественности: elevenlabs > yandex > edge > piper
#   elevenlabs: лучшие голоса в мире, 10 тыс. символов в месяц бесплатно (2-3 ролика), дальше от $5/мес
#   yandex:     Яндекс SpeechKit, очень естественный русский, доступен из России, копейки за ролик
#   edge:       бесплатно, без ключа, голоса Microsoft
#   piper:      полностью локально
TTS_PROVIDER=edge
# Голоса edge: ru-RU-DmitryNeural (мужской), ru-RU-SvetlanaNeural (женский)
EDGE_VOICE=ru-RU-SvetlanaNeural
# Темп и высота: +10% бодрее, -5% спокойнее; высота например +2Hz / -3Hz
EDGE_RATE=+10%
EDGE_PITCH=+0Hz
# Паузы в озвучке длиннее PAUSE_MAX_SECONDS сжимаются до этого значения
PAUSE_MAX_SECONDS=0.3
# Piper: голоса ru_RU-irina-medium, ru_RU-dmitri-medium, ru_RU-denis-medium, ru_RU-ruslan-medium
PIPER_VOICE=ru_RU-irina-medium
PIPER_DIR=models/piper
# <1 быстрее и бодрее; больше NOISE_W = менее монотонно
PIPER_LENGTH_SCALE=0.92
PIPER_NOISE_W=0.9
# ElevenLabs: ключ в профиле (API Keys), voice_id в библиотеке голосов. Для русского ищи голоса с пометкой Russian.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# stability ниже = живее, но менее стабильно; style выше = экспрессивнее
ELEVENLABS_STABILITY=0.45
ELEVENLABS_STYLE=0.3
ELEVENLABS_SPEED=1.05
# Яндекс SpeechKit: console.yandex.cloud -> сервисный аккаунт с ролью ai.speechkit-tts.user -> API-ключ
# Голоса женские: marina, dasha, lera, masha, julia, jane; мужские: kirill, anton, alexander, ermil, zahar, filipp
YANDEX_API_KEY=
YANDEX_VOICE=marina
# Эмоция, если голос поддерживает: good | neutral | friendly | strict | whisper
YANDEX_EMOTION=
YANDEX_SPEED=1.05

# ---------- Тайминг субтитров ----------
# Модель faster-whisper: tiny | base | small | medium. small = хороший баланс.
WHISPER_MODEL=small
WHISPER_DIR=models/whisper

# ---------- Видео ----------
# gameplay: случайный фрагмент из GAMEPLAY_DIR | generated: сцены генерирует нейросеть под каждую фразу
BACKGROUND_MODE=gameplay
GAMEPLAY_DIR=assets/gameplay

# Генерация сцен локально (нужна NVIDIA, установка: bash install.sh --video)
# wan22-5b: лучшее качество, 24 ГБ видеопамяти | wan21-1.3b: быстро, от 8 ГБ | wan21-14b: медленно, максимум деталей
VIDEO_MODEL=wan22-5b
# 0 = шаги из пресета (40 для 5b). Меньше шагов = быстрее, но грубее; 25-30 разумный минимум
VIDEO_STEPS=0
# Выгрузка частей модели на процессор: экономит видеопамять, чуть медленнее
VIDEO_OFFLOAD=true
# Длина одной сцены в секундах и общий визуальный стиль всех сцен (на английском)
VIDEO_SCENE_SECONDS=5
VIDEO_STYLE=cinematic realistic footage, soft natural light, shallow depth of field, muted colors, film grain
# 0 = случайное зерно, любое другое число делает результат повторяемым
VIDEO_SEED=0
# Для скачивания бесплатных стоковых фонов: python -m shorts backgrounds fetch
# Ключ бесплатный и выдаётся сразу: https://www.pexels.com/api/
PEXELS_API_KEY=
OUT_DIR=out
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
SUBTITLE_FONT=DejaVu Sans
# Сколько слов показывать одновременно
SUBTITLE_WORDS_PER_LINE=3

# ---------- Стиль канала ----------
CHANNEL_TOPIC=наука и технологии
CHANNEL_STYLE=живой, простой, без канцелярита, как рассказ другу
TARGET_SECONDS=50
