# ---------- Нейросеть для сценария ----------
# ollama (локально, по умолчанию) | anthropic (облако, опционально)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Хорошо говорит по-русски: qwen2.5:7b, qwen2.5:14b, gemma3:12b
OLLAMA_MODEL=qwen2.5:7b
# Только если LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------- Озвучка ----------
# piper (локально, по умолчанию) | edge (бесплатное облако Microsoft) | elevenlabs (платное облако)
TTS_PROVIDER=piper
PIPER_VOICE=ru_RU-irina-medium
PIPER_DIR=models/piper
EDGE_VOICE=ru-RU-DmitryNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------- Тайминг субтитров ----------
# Модель faster-whisper: tiny | base | small | medium. small = хороший баланс.
WHISPER_MODEL=small
WHISPER_DIR=models/whisper

# ---------- Видео ----------
GAMEPLAY_DIR=assets/gameplay
OUT_DIR=out
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
SUBTITLE_FONT=DejaVu Sans
# Сколько слов показывать одновременно
SUBTITLE_WORDS_PER_LINE=3

# ---------- Стиль канала ----------
CHANNEL_TOPIC=наука и технологии
CHANNEL_STYLE=живой, простой, без канцелярита, как рассказ другу
TARGET_SECONDS=50
